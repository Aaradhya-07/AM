+type RestrictionEvidence = z.infer<typeof CandidateEvidence> | undefined;
+type SourcedRestrictionValue = z.infer<typeof SourcedRestriction> | undefined;
+type RestrictionStanding = {
+  status: "not_configured" | "allowed" | "excluded" | "unknown";
+  value: string | null;
+  evidence_source: string | null;
+  restriction_source: string | null;
+  reason: string;
+};
+
+function restrictionSummary(
+  name: string,
+  standing: RestrictionStanding,
+): string {
+  if (standing.status === "not_configured") return `${name} not configured`;
+  const sources = [
+    standing.evidence_source ? `evidence: ${standing.evidence_source}` : null,
+    standing.restriction_source
+      ? `restriction: ${standing.restriction_source}`
+      : null,
+  ].filter((item): item is string => item !== null);
+  return `${name} ${standing.status} (${standing.value ?? "value unknown"}${sources.length ? `; ${sources.join("; ")}` : ""})`;
+}
+
+function restrictionStanding(
+  restriction: SourcedRestrictionValue,
+  evidence: RestrictionEvidence,
+): RestrictionStanding {
+  if (!restriction)
+    return {
+      status: "not_configured",
+      value: evidence?.value ?? null,
+      evidence_source: evidence?.source ?? null,
+      restriction_source: null,
+      reason: "no restriction configured",
+    };
+  if (!evidence)
+    return {
+      status: "unknown",
+      value: null,
+      evidence_source: null,
+      restriction_source: restriction.source,
+      reason: `hard restriction cannot be checked; candidate evidence missing (restriction source: ${restriction.source})`,
+    };
+  const match = restriction.allowed.some(
+    (value) => value.toLowerCase() === evidence.value.toLowerCase(),
+  );
+  return {
+    status: match ? "allowed" : "excluded",
+    value: evidence.value,
+    evidence_source: evidence.source,
+    restriction_source: restriction.source,
+    reason: match
+      ? `allowed by restriction source ${restriction.source}; candidate evidence source ${evidence.source}`
+      : `value ${evidence.value} is outside the hard restriction (restriction source: ${restriction.source}; candidate evidence source: ${evidence.source})`,
+  };
+}
