# Braintrust validation experiment — environment template
#
# NAMES ONLY. NO SECRETS. NO VALUES.
#
# Copy to .env in the THROWAWAY repository (never in this one) and fill in
# there. Do not paste credentials into chat, into this repository, or into any
# file that is committed.
#
#   cp .env.example .env      # then edit .env, which must stay untracked

# --- Credentials (founder supplies, in the throwaway repo only) -------------

# From the Braintrust console after account creation.
BRAINTRUST_API_KEY=

# Dedicated provider key WITH A HARD SPEND CAP. Never a production key.
# Phase D runs the same configuration repeatedly on purpose; an uncapped key is
# the wrong way to find out how expensive that is.
OPENAI_API_KEY=

# --- Scenario configuration -------------------------------------------------

# Which arm this run executes: "old" | "new" | "control"
SCENARIO_ARM=old

# Tag distinguishing runs in the Braintrust UI, e.g. run1, run2, control.
RUN_TAG=run1

# Scenario 1: dataset file. Point at data/s1-repeat.jsonl for the T7 control.
S1_DATASET=data/s1-tickets.jsonl

# Model identifiers. Must also be set in scenarios.json, replacing the
# REPLACE_WITH_* placeholders. Choose two models whose prices differ materially.
S1_OLD_MODEL=
S1_NEW_MODEL=
S2_MODEL=

# --- Cost control -----------------------------------------------------------

# Lower to 25 if the provider spend cap binds. Scenario 2 is the expensive half.
S2_DOC_COUNT=100
